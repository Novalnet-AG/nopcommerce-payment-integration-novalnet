@model ConfigurationModel
@{
    Layout = "_ConfigurePlugin";
}
@using Nop.Plugin.Payments.NovalnetApplePay.Models

@await Component.InvokeAsync(typeof(StoreScopeConfigurationViewComponent))

<form asp-controller="NovalnetApplePay" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">

                @(await Html.LocalizedEditorAsync<ConfigurationModel, ConfigurationModel.ConfigurationLocalizedModel>("plugin-settings-localized",
                @<div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="DescriptionText_OverrideForStore" asp-input="@Model.Locales[item].DescriptionText" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="@Model.Locales[item].DescriptionText" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="@Model.Locales[item].DescriptionText" />
                            <span asp-validation-for="@Model.Locales[item].DescriptionText"></span>
                        </div>
                    </div>
                    <input type="hidden" asp-for="@Model.Locales[item].LanguageId" />
                </div>
                ,
                @<div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="DescriptionText_OverrideForStore" asp-input="DescriptionText" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="DescriptionText" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="DescriptionText" />
                            <span asp-validation-for="DescriptionText"></span>
                        </div>
                    </div>
                </div>
                ,
                //localizable settings per store (overridden store settings) are not supported yet
                true
                ))

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="TestMode_OverrideForStore" asp-input="TestMode" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="TestMode" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="TestMode" />
                        <span asp-validation-for="TestMode"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="PaymentActionString" />
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="PaymentActionString" asp-items="Model.AvailablePaymentActions" class="form-control" />
                        <nop-override-store-checkbox asp-for="PaymentAction_OverrideForStore"
                                                    asp-input="PaymentActionString"
                                                    asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <span asp-validation-for="PaymentActionString" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="OnholdMinAmount_OverrideForStore" asp-input="OnholdMinAmount" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="OnholdMinAmount" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="OnholdMinAmount" />
                        <span asp-validation-for="OnholdMinAmount"></span>
                    </div>
                </div>



                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="BusinessName_OverrideForStore" asp-input="BusinessName" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="BusinessName" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="BusinessName" />
                        <span asp-validation-for="BusinessName"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="ButtonType_OverrideForStore" asp-input="ButtonType" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="ButtonType" asp-display-hint="false" />
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="ButtonType" asp-items="Model.AvailableButtonTypes" class="form-control" />
                        <span asp-validation-for="ButtonType"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="ButtonTheme_OverrideForStore" asp-input="ButtonTheme" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="ButtonTheme" asp-display-hint="false" />
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="ButtonTheme" asp-items="Model.AvailableButtonThemes" class="form-control" />
                        <span asp-validation-for="ButtonTheme"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="ButtonHeight_OverrideForStore" asp-input="ButtonHeight" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="ButtonHeight" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ButtonHeight" />
                        <span asp-validation-for="ButtonHeight"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="ButtonCornerRadius_OverrideForStore" asp-input="ButtonCornerRadius" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="ButtonCornerRadius" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ButtonCornerRadius" />
                        <span asp-validation-for="ButtonCornerRadius"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="DisplayPages_OverrideForStore" asp-input="SelectedDisplayPages" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="SelectedDisplayPages" />
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="SelectedDisplayPages" asp-items="Model.AvailableDisplayPages" asp-multiple="true" />
                        <span asp-validation-for="SelectedDisplayPages"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="AdditionalFee_OverrideForStore" asp-input="AdditionalFee" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="AdditionalFee" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AdditionalFee" />
                        <span asp-validation-for="AdditionalFee"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-override-store-checkbox asp-for="AdditionalFeePercentage_OverrideForStore" asp-input="AdditionalFeePercentage" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                        <nop-label asp-for="AdditionalFeePercentage" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AdditionalFeePercentage" />
                        <span asp-validation-for="AdditionalFeePercentage"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>